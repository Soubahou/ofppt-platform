{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "OFPPT API Gateway — single entry point for all frontend requests",
  "type": "module",
  "scripts": {
    "dev":   "nodemon --watch src src/app.js",
    "start": "node src/app.js",
    "lint":  "node --check src/app.js src/middleware/*.js src/proxy/*.js src/routes/*.js src/utils/*.js"
  },
  "dependencies": {
    "cors":                   "^2.8.5",
    "dotenv":                 "^16.4.5",
    "express":                "^4.18.3",
    "express-rate-limit":     "^7.2.0",
    "helmet":                 "^7.1.0",
    "http-proxy-middleware":  "^3.0.0",
    "pino":                   "^8.19.0",
    "pino-pretty":            "^11.0.0",
    "uuid":                   "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
