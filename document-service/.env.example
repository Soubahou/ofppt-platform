# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3003
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://docuser:docpassword@localhost:3309/document_db

# ── Cross-service URLs ─────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
ACADEMIC_SERVICE_URL=http://localhost:3002

# ── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── File storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_DOCUMENT_SIZE_MB=20
MAX_SUBMISSION_SIZE_MB=10

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── MySQL container (used only in docker-compose.yml) ─────────────────────────
DOCUMENT_MYSQL_ROOT_PASSWORD=rootpassword
DOCUMENT_MYSQL_USER=docuser
DOCUMENT_MYSQL_PASSWORD=docpassword
