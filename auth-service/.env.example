# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# For local development without Docker:
DATABASE_URL=mysql://authuser:authpassword@localhost:3307/auth_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email Configuration ───────────────────────────────────────────────────────
EMAIL_DOMAIN=ofppt.ma

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── MySQL (used by docker-compose only) ───────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=authuser
MYSQL_PASSWORD=authpassword