# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# For local development (academic DB on port 3308):
DATABASE_URL=mysql://acaduser:acadpassword@localhost:3308/academic_db

# ── Auth service ──────────────────────────────────────────────────────────────
# URL used to verify tokens and look up users.
# In Docker: http://auth-service:3001
# Locally:   http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3001

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Cleanup job ───────────────────────────────────────────────────────────────
# How many days to keep cancelled session instances before deleting them
CANCELLED_INSTANCE_RETENTION_DAYS=30

# ── MySQL (used by docker-compose only) ───────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=acaduser
MYSQL_PASSWORD=acadpassword
